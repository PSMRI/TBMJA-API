{
  "name": "tbmja-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "commit": "cz"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
